SITE_URL=http://localhost:3000

# Supabase project settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Paystack dashboard -> Settings -> API Keys & Webhooks
# Use TEST keys for local dev / Vercel previews, LIVE keys only in production.
PAYSTACK_SECRET_KEY=

# Resend dashboard -> API Keys
RESEND_API_KEY=
EMAIL_FROM="The Joy Project <tickets@yourdomain.com>"
ORGANIZER_EMAIL=organizers@yourdomain.com

# /admin and /checkin — deliberately separate so a leaked door-volunteer
# password can never expose sales/revenue data.
ADMIN_PASSWORD=
CHECKIN_PASSWORD=

# Any long random string, e.g. `openssl rand -hex 32`
AUTH_COOKIE_SECRET=
QR_SIGNING_SECRET=
